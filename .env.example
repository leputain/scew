# Timezone
TZ=Europe/Moscow

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_BIND_PORT=20602
POSTGRES_DB=screw
POSTGRES_USER=screw
POSTGRES_PASSWORD=

# Telegram bot
ATTENDANCE_BOT_TOKEN=
# attendance_bot uses aiogram only. Rollback is performed with a previous image.
# System messages: try Bot API rich messages first, then fallback to HTML.
TELEGRAM_RICH_MESSAGES_ENABLED=1
# Optional reactions from bot to its own system messages. Keep 0 unless explicitly wanted.
TELEGRAM_SYSTEM_REACTIONS_ENABLED=0

# Docker build dependencies: 0 = install from PyPI, 1 = install from local wheelhouse/.
PIP_NO_INDEX=0

# Optional container/image/proxy settings.
IMAGE_REPOSITORY=screw
TAG=latest
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db

# Telegram chats
MAIN_GROUP_CHAT_ID=
# ID группы для опросов явки (куда бот отправляет ежедневные опросы)
ATTENDANCE_GROUP_ID=
# Дополнительный allowlist групп/чатов, где боту разрешено отвечать.
# Формат: -100111,-100222. Основные chat id ниже добавляются автоматически.
ATTENDANCE_ALLOWED_GROUP_IDS=

# =============================================================================
# Invite/Chat Links — ссылки для приглашения сотрудников
# =============================================================================

# Общая рабочая группа (приглашение для ВСЕХ новых сотрудников после одобрения)
# Формат: https://t.me/+ABC123 или https://t.me/joinchat/ABC123
# Опционально: если не задано, пользователю покажется сообщение обратиться к менеджеру
ATTENDANCE_GROUP_INVITE_LINK=

# Ссылки для сотрудников ОЗКО (отправляются дополнительно после одобрения OZKO)
# Операционный чат бота (где бот отправляет уведомления об изменениях)
OZKO_BOT_CHAT_INVITE_LINK=
# Чат отдела ОЗКО (общий чат сотрудников отдела)
OZKO_DEPT_CHAT_INVITE_LINK=

# Violations chat (OZKO) — отдельный чат для нарушений
# ID чата для отправки уведомлений о нарушениях (required для violations)
VIOLATIONS_OZKO_CHAT_ID=
# Включить отправку уведомлений о нарушениях (1 = вкл, 0 = выкл, по умолчанию 0)
VIOLATIONS_NOTIFY_ENABLED=0
# Включить поздравления с ДР отдельно от нарушений (1 = вкл, 0 = выкл)
BIRTHDAY_NOTIFY_ENABLED=0
# Optional: отдельный чат для ДР; если пусто, используется VIOLATIONS_OZKO_CHAT_ID
BIRTHDAY_NOTIFY_CHAT_ID=
# Optional: Telegram forum topic id для поздравлений. Например, topic "Поздравляшки".
BIRTHDAY_NOTIFY_MESSAGE_THREAD_ID=
# Максимум строк в одном сообщении (по умолчанию 50)
VIOLATIONS_NOTIFY_MAX_LINES=50

# =============================================================================
# Flud / informal chat pulse
# =============================================================================

FLUD_ENABLED=0
FLUD_CHAT_ID=
# Optional: Telegram forum topic id for flud topic. Leave empty for whole chat.
FLUD_MESSAGE_THREAD_ID=
# Optional; if empty, use VIOLATIONS_OZKO_CHAT_ID
FLUD_DIGEST_CHAT_ID=
FLUD_STORE_TEXT_PREVIEW=0
FLUD_TEXT_PREVIEW_MAX_CHARS=120
FLUD_RETENTION_DAYS=90
FLUD_WEEKLY_DIGEST_ENABLED=0
FLUD_WEEKLY_DIGEST_DAY_OF_WEEK=5
FLUD_WEEKLY_DIGEST_HOUR=17
FLUD_WEEKLY_DIGEST_MINUTE=0
FLUD_MONTHLY_DIGEST_ENABLED=0
FLUD_MONTHLY_DIGEST_HOUR=17
FLUD_MONTHLY_DIGEST_MINUTE=30
FLUD_REACTIONS_ENABLED=1
FLUD_DIGEST_MESSAGE_LINKS_ENABLED=0
FLUD_TOP_LIMIT=5

# Poll settings
# Длительность опроса в секундах (по умолчанию 900 = 15 минут)
POLL_DURATION_SECONDS=3600
# Optional Bot API 10.0 poll description. Rich media is configured via DB poll_config.poll_options.
POLL_DESCRIPTION=
# Optional separate chat for poll close summary and per-option replies.
POLL_SUMMARY_CHAT_ID=
# Optional separate chat for combined OZKO/OSB attendance lists after poll close.
DEPARTMENT_LISTS_CHAT_ID=
# Интервал проверки просроченных опросов reaper'ом (по умолчанию 30 сек)
POLL_REAPER_INTERVAL_SECONDS=30
# Напоминание неответившим за N минут до закрытия опроса (пусто = выключено)
POLL_REMINDER_BEFORE_END_MINUTES=1

# Healthcheck/self-healing
# Liveness проверяет только процесс/event loop через heartbeat-файл.
# Pending Telegram updates используются отдельной диагностикой и не перезапускают контейнер.
HEARTBEAT_PENDING_UPDATES_THRESHOLD=100
HEARTBEAT_MAX_FAILURES=3

# Legacy fixed-time violations check.
# Основная отправка нарушений привязана к закрытию конкретного опроса.
VIOLATIONS_FIXED_CHECK_ENABLED=0
VIOLATIONS_FIXED_CHECK_HOUR=9
VIOLATIONS_FIXED_CHECK_MINUTE=35

# Roles (comma-separated Telegram IDs)
ADMIN_TELEGRAM_IDS=
MANAGER_OZKO_TELEGRAM_IDS=
MANAGER_OSB_TELEGRAM_IDS=

# =============================================================================
# Policy settings — политика посещений
# =============================================================================

POLICY_VACATION_DISCOUNT_ENABLED=1
POLICY_VACATION_DISCOUNT_TABLE=5-7:-2,10-14:-4

# Daily report (ежедневный отчёт в Telegram)
REPORT_DAILY_ENABLED=0
REPORT_DAILY_HOUR=18
REPORT_DAILY_MINUTE=0

# Месячная Telegram-статистика явки ОЗКО.
# Автопубликация: 1 числа за предыдущий месяц; ручная публикация доступна
# в админ-панели через предпросмотр и подтверждение.
MONTHLY_STATS_ENABLED=0

# =============================================================================
# Email reports (EWS) — отчёты по email через Exchange
# =============================================================================

# Exchange EWS (on-prem, NTLM)
EXCHANGE_EWS_URL=
EXCHANGE_USERNAME=
EXCHANGE_PASSWORD=
EXCHANGE_AUTH=NTLM

# Получатели отчётов
REPORT_TO=
# REPORT_CC=

# Ежедневные email-отчёты
REPORT_MAIL_ENABLED=0
REPORT_MAIL_HOUR=9
REPORT_MAIL_MINUTE=35

# Результаты опроса по email
POLL_RESULTS_EMAIL_ENABLED=0
POLL_RESULTS_EMAIL_TO=
# POLL_RESULTS_EMAIL_CC=

# Месячный email-отчёт
REPORT_MONTHLY_ENABLED=0
REPORT_MONTHLY_SEND_HOUR=10
REPORT_MONTHLY_SEND_MINUTE=0

# =============================================================================
# DEV-ONLY: Настройки для разработки и тестирования
# =============================================================================

# ВНИМАНИЕ: В продакшене ОБЯЗАТЕЛЬНО должны быть 0!
DEV_ALLOW_SELF_REGISTRATION=0
DEV_BOOTSTRAP_ADMINS=0
DEBUG_NAVIGATION=0

# Optional welcome message customization. Do not commit personal contacts or internal URLs.
ATTENDANCE_WELCOME_OZKO_CONTACT=
ATTENDANCE_WELCOME_OSB_CONTACT=
ATTENDANCE_WORKPLACE_SETUP_URL=
